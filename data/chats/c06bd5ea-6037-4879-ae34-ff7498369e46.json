      "text": "\u092e\u0941\u0902\u092c\u0908\u092e\u0927\u094d\u092f\u0947 \u0906\u091c\u091a\u0947 \u0939\u0935\u093e\u092e\u093e\u0928 \u0905\u0902\u0936\u0924\u0903 \u0922\u0917\u093e\u0933 \u0905\u0938\u0942\u0928 \u0924\u093e\u092a\u092e\u093e\u0928 \u0938\u0941\u092e\u093e\u0930\u0947 \u090f\u0915\u0924\u0940\u0938 \u0905\u0902\u0936 \u0938\u0947\u0932\u094d\u0938\u093f\u0905\u0938 \u0906\u0939\u0947. \u0906\u0930\u094d\u0926\u094d\u0930\u0924\u093e \u0938\u0941\u092e\u093e\u0930\u0947 \u0938\u0924\u094d\u0924\u0930 \u0924\u0947 \u0936\u0939\u093e\u0924\u094d\u0924\u0930 \u091f\u0915\u094d\u0915\u0947 \u0905\u0938\u0932\u094d\u092f\u093e\u0928\u0947 \u0924\u0947 \u090f\u0915\u0936\u0947 \u0926\u094b\u0928 \u0905\u0902\u0936 \u0938\u0947\u0932\u094d\u0938\u093f\u0905\u0938\u0938\u093e\u0930\u0916\u0947 \u091c\u093e\u0923\u0935\u0924\u0947.\n\n\u092a\u0941\u0922\u0940\u0932 \u0915\u093e\u0939\u0940 \u0926\u093f\u0935\u0938\u093e\u0902\u0938\u093e\u0920\u0940 \u0939\u0935\u093e\u092e\u093e\u0928 \u0905\u0902\u0926\u093e\u091c \u091c\u093e\u0923\u0942\u0928 \u0918\u094d\u092f\u093e\u092f\u091a\u093e \u0906\u0939\u0947 \u0915\u093e?"
