# Required — Google Gemini (LLM, transcription, optional TTS)
GEMINI_API_KEY=

# Required — Langfuse prompt management
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_PROMPT_LABEL=develop

# Langfuse prompt names (defaults shown)
SYSTEM_PROMPT_NAME=system-prompt-luvio
WEB_SEARCH_PROMPT_NAME=web-search-luvio
HOLDING_RESPONSE_PROMPT_NAME=holding-response-luvio
MEETING_NOTES_EXTRACT_PROMPT_NAME=meeting-notes-extract-luvio
MEETING_NOTES_RETRIEVAL_PROMPT_NAME=meeting-notes-retrieval-luvio

# AI Notes — meeting embeddings and sessions
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
AI_NOTES_SESSION_TTL_SECONDS=86400
AI_NOTES_CHUNK_INTERVAL_SECONDS=30

# TTS (server-side Gemini TTS; playground default uses browser speech)
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
STREAM_TTS_MODE=browser

# Optional — Spotify playback control
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/spotify/callback
SPOTIFY_MARKET=IN

# Redis short-term memory (start with: docker compose up -d)
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_STM_MAX_MESSAGES=40
REDIS_STM_TTL_SECONDS=604800
STM_HISTORY_TURN_LIMIT=5

# Optional — Mem0 long-term memory
MEM0_API_KEY=
MEM0_SEARCH_LIMIT=5
DEFAULT_USER_ID=playground-default
